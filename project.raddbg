// raddbg 0.9.30 project file

name: "The RAD Debugger"
target:
{
  executable: "build/raddbg.exe"
  working_directory: build
  arguments: "--user:raddbg_test.user"
  debug_subprocesses: 0
}
target:
{
  executable: "build/raddbg_server.exe"
  working_directory: build
  debug_subprocesses: 1
}
target:
{
  executable: "build/metagen.exe"
  working_directory: build
  enabled: 1
}
target:
{
  executable: "build/mule_main.exe"
  working_directory: build
}
target:
{
  executable: "build/torture.exe"
  working_directory: build
  arguments: *
}
watch_pin: expression: tag_hash_slots
target:
{
  executable: "build/ryan_scratch.exe"
  working_directory: build
}
target:
{
  executable: "build/raddbg"
  working_directory: build
  arguments: "--user:raddbg_test.user"
}
target:
{
  executable: "build/metagen"
  working_directory: build
}
target:
{
  executable: "../jai/examples/invaders/invaders"
  working_directory: "../jai/examples/invaders"
}
linux_sigpipe: 1
