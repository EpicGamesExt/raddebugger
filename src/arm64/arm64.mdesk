@table(name  base  off  size  is_vector  has_rdi  has_dwarf)
ARM64_RegTable:
{
  {nil               -       0       0    - x -  }
  {x0                -       0       8    - x x  }
  {x1                -       0       8    - x x  }
  {x2                -       0       8    - x x  }
  {x3                -       0       8    - x x  }
  {x4                -       0       8    - x x  }
  {x5                -       0       8    - x x  }
  {x6                -       0       8    - x x  }
  {x7                -       0       8    - x x  }
  {x8                -       0       8    - x x  }
  {x9                -       0       8    - x x  }
  {x10               -       0       8    - x x  }
  {x11               -       0       8    - x x  }
  {x12               -       0       8    - x x  }
  {x13               -       0       8    - x x  }
  {x14               -       0       8    - x x  }
  {x15               -       0       8    - x x  }
  {x16               -       0       8    - x x  }
  {x17               -       0       8    - x x  }
  {x18               -       0       8    - x x  }
  {x19               -       0       8    - x x  }
  {x20               -       0       8    - x x  }
  {x21               -       0       8    - x x  }
  {x22               -       0       8    - x x  }
  {x23               -       0       8    - x x  }
  {x24               -       0       8    - x x  }
  {x25               -       0       8    - x x  }
  {x26               -       0       8    - x x  }
  {x27               -       0       8    - x x  }
  {x28               -       0       8    - x x  }
  {fp                -       0       8    - x x  }
  {lr                -       0       8    - x x  }
  {sp                -       0       8    - x x  }
  {pc                -       0       8    - x x  }
  {v0                -       0      16    x x x  }
  {v1                -       0      16    x x x  }
  {v2                -       0      16    x x x  }
  {v3                -       0      16    x x x  }
  {v4                -       0      16    x x x  }
  {v5                -       0      16    x x x  }
  {v6                -       0      16    x x x  }
  {v7                -       0      16    x x x  }
  {v8                -       0      16    x x x  }
  {v9                -       0      16    x x x  }
  {v10               -       0      16    x x x  }
  {v11               -       0      16    x x x  }
  {v12               -       0      16    x x x  }
  {v13               -       0      16    x x x  }
  {v14               -       0      16    x x x  }
  {v15               -       0      16    x x x  }
  {v16               -       0      16    x x x  }
  {v17               -       0      16    x x x  }
  {v18               -       0      16    x x x  }
  {v19               -       0      16    x x x  }
  {v21               -       0      16    x x x  }
  {v22               -       0      16    x x x  }
  {v23               -       0      16    x x x  }
  {v24               -       0      16    x x x  }
  {v25               -       0      16    x x x  }
  {v26               -       0      16    x x x  }
  {v27               -       0      16    x x x  }
  {v28               -       0      16    x x x  }
  {v29               -       0      16    x x x  }
  {v30               -       0      16    x x x  }
  {v31               -       0      16    x x x  }
  {elr_mode          -       0       8    - - x  }
  {ra_sign_state     -       0       8    - - x  }
  {tpidrro_elo       -       0       8    - - x  }
  {tpidr_elo         -       0       8    - - x  }
  {tpidr_el1         -       0       8    - - x  }
  {tpidr_el2         -       0       8    - - x  }
  {tpidr_el3         -       0       8    - - x  }
  //-
  //- aliases
  //-
  {x29               fp      0       8    - - -  }
  {x30               lr      0       8    - - -  }
  {x31               sp      0       8    - - -  }
}

@enum ARM64_RegCode:
{
  @expand(ARM64_RegTable a) `$(a.name)`,
  COUNT,
}

@struct ARM64_RegBlock:
{
  @expand(ARM64_RegTable a) `$(a.name != 'nil' && a.base == '-' -> 'U' .. a.size*8 .. ' ' .. a.name)`,
}

@data(B8) arm64_reg_code_is_vector_table:
{
  @expand(ARM64_RegTable a) `$(a.is_vector == 'x' -> '1')$(a.is_vector != 'x' -> '0')`;
}

@data(String8) arm64_reg_code_name_table:
{
  @expand(ARM64_RegTable a) `str8_lit_comp("$(a.name)")`;
}

@data(U8) arm64_reg_code_base_table:
{
  @expand(ARM64_RegTable a) `$(a.base != '-' -> "ARM64_RegCode_" .. a.base)$(a.base == '-' -> 0)`;
}

@data(Rng1U16) arm64_reg_code_rng_table:
{
  `{0}`,
  @expand(ARM64_RegTable a) `$(a.name != 'nil' && a.base == '-'-> ("{(U16)OffsetOf(ARM64_RegBlock, " .. a.name .. "), (U16)OffsetOf(ARM64_RegBlock, " .. a.name .. ") + " .. a.size .. "}"))$(a.name != 'nil' && a.base != '-' -> ("{(U16)OffsetOf(ARM64_RegBlock, " .. a.base .. ") + " .. a.off .. ", (U16)OffsetOf(ARM64_RegBlock, " .. a.base .. ") + " .. a.off .. " + " .. a.size .. "}"))`,
}
