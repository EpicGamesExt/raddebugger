    entry_obj:
    {
      file_name: "entry.obj"
      coff: { object:
      {
        machine: x64
        sections:
        {
          text:
          {
            name: ".text"
            permissions: (read, execute)
            content: code
            data:
            {
              concat:
              {
                hex: "48c7c000000000" // mov rax, $imm
                hex: "c3"             // ret
              }
            }
            relocations: { shared_count_ref: { type: Addr32Nb, offset: 3, symbol: shared_count_destroy } }
          }
        }
        symbols:
        {
          entry: { kind: external, name: "entry", section: text, value: 0 }
          shared_count_destroy: { kind: undefined, name: "??_E__shared_count@__Cr@std@@MEAAPEAXI@Z" }
        }
      } }
    }
  }

