  {
    link:
    {
      args: "/subsystem:console /entry:entry /out:a.exe a.obj b.obj entry.obj"
    }
    link:
    {
      args: "/subsystem:console /entry:entry /out:a.exe b.obj a.obj entry.obj"
    }
  }
